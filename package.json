{
  "name": "kamae-ts",
  "version": "1.4.0",
  "description": "Kamae (構え) — an extensible harness of skill plugins for designing and implementing robust server-side TypeScript applications",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iwasa-kosui/kamae-ts"
  },
  "scripts": {
    "benchmark": "bun run benchmarks/runner/run.ts",
    "benchmark:regrade": "bun run benchmarks/runner/regrade.ts",
    "benchmark:test": "bun test ./benchmarks/runner",
    "benchmark:typecheck": "tsc --project benchmarks/tsconfig.json",
    "benchmark:scenarios": "bun run benchmarks/design-scenarios/cli.ts",
    "benchmark:scenarios:test": "bun test ./benchmarks/design-scenarios/pack.test.ts",
    "gen:og-image": "bun run scripts/gen-og-image.ts",
    "gen:og-image-community": "bun run scripts/gen-og-image-community.ts"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "1.3.0",
    "satori": "^0.26.0",
    "typescript": "5.9.2"
  }
}
